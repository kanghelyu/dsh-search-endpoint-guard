{
  "name": "dsh-search-endpoint-guard",
  "version": "0.1.0",
  "description": "Diagnose and align the web_search endpoint with your LLM provider endpoint, for users running DeepSeek Harness on a non-official (proxy/gateway) provider. / 诊断并对齐 web_search 端点，帮助使用非官方（代理/网关）提供商的 DeepSeek Harness 用户。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kanghelyu/dsh-search-endpoint-guard.git"
  },
  "homepage": "https://github.com/kanghelyu/dsh-search-endpoint-guard",
  "bugs": {
    "url": "https://github.com/kanghelyu/dsh-search-endpoint-guard/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1-rc.1",
    "@deepseek-ai/dsh-credentials": "^0.0.1-rc.1",
    "@deepseek-ai/dsh-launch-environment": "^0.0.1-rc.1",
    "@deepseek-ai/dsh-tools": "^0.0.1-rc.1",
    "@deepseek-ai/schemastery": "^3.18.1-rc.1"
  }
}
